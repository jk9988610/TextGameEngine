{
  "game_title": "森林试炼",
  "game_intro": "村口老守卫托付给你一件小事：去森林打败史莱姆、拿到钥匙，到洞穴深处取回遗落的宝物。",
  "initial_scene": "village",
  "initial_inventory": [
    "iron_sword"
  ],
  "initial_gold": 10,
  "player": {
    "hp": 50,
    "attack": 5,
    "defense": 2
  },
  "action_time": {
    "move_scene": 300,
    "take_item": 20,
    "drop_item": 20,
    "combat_turn": 60,
    "buy_item": 20
  },
  "_proto_retreat": {
    "enabled": true,
    "recover_seconds": 600
  },
  "_proto_defend": {
    "enabled": true,
    "reduction": 0.5
  },
  "_proto_turnorder": {
    "enabled": true
  },
  "_proto_beatcombat": {
    "enabled": true,
    "ap_start": 1,
    "ap_per_beat": 1,
    "ap_max": 3,
    "cost_attack": 1,
    "cost_block": 0,
    "cost_dodge": 2,
    "cost_charge": 0,
    "cost_disengage": 2,
    "heavy_damage": 10,
    "low_hp_ratio": 0.25,
    "player_heavy_bonus": 2,
    "player_heavy_mult": 2
  },
  "event_rules": [
    {
      "id": "slime_drops_key_unlocks_cave",
      "label": "击败史莱姆 → 拿到钥匙并解锁洞穴门",
      "on": "ENEMY_KILLED",
      "if": {
        "enemy_id": "slime"
      },
      "do": [
        {
          "type": "unlock",
          "scene": "forest",
          "exit": "cave"
        }
      ]
    },
    {
      "id": "claim_treasure_sets_flag",
      "label": "在洞穴捡起金币宝藏 → 标记试炼完成",
      "on": "ITEM_TAKEN",
      "if": {
        "item_id": "gold_coin",
        "from_scene": "cave"
      },
      "do": [
        {
          "type": "set_flag",
          "flag": "demo_complete"
        }
      ]
    }
  ]
}
