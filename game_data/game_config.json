{
  "game_title": "森林试炼",
  "game_intro": "村口老守卫托付给你一件小事：去森林打败史莱姆、拿到钥匙，到洞穴深处取回遗落的宝物。",
  "initial_scene": "village",
  "initial_inventory": [
    "iron_sword"
  ],
  "initial_gold": 10,
  "player": {
    "hp": 50,
    "attack": 5,
    "defense": 2
  },
  "action_time": {
    "move_scene": 300,
    "take_item": 20,
    "drop_item": 20,
    "combat_turn": 60,
    "buy_item": 20
  },
  "beat_combat": {
    "enabled": true,
    "recover_seconds": 600,
    "ap_start": 1,
    "ap_per_beat": 1,
    "ap_max": 3,
    "cost_attack": 1,
    "cost_block": 0,
    "cost_dodge": 2,
    "cost_charge": 0,
    "cost_disengage": 2,
    "actions": {
      "attack": {
        "label": "攻击",
        "description": "用装备造成普通武器伤害。",
        "cost": 1,
        "tag": "直接伤害",
        "consume_state": "readied",
        "effects": [
          {
            "type": "weapon_damage",
            "subtract_target_defense": true,
            "minimum": 1,
            "charged_bonus_key": "player_heavy_bonus",
            "charged_multiplier_key": "player_heavy_mult"
          }
        ],
        "interactions": {
          "dodge": [
            {
              "type": "miss"
            },
            {
              "type": "expose_player",
              "when": "charged"
            }
          ],
          "brace": [
            {
              "type": "miss",
              "when": "not_charged"
            }
          ],
          "charge": [
            {
              "type": "interrupt",
              "when": "hit"
            }
          ]
        }
      },
      "charge": {
        "label": "蓄力",
        "description": "在安全的一拍蓄力，下一拍攻击转为重击。",
        "cost": 0,
        "tag": "准备",
        "effects": [
          {
            "type": "apply_state",
            "state": "readied",
            "duration_beats": 1,
            "clear_state_on_damage": true
          }
        ]
      },
      "block": {
        "label": "格挡",
        "description": "放弃进攻，降低本拍受到的撞击伤害。",
        "cost": 0,
        "tag": "防御",
        "interactions": {
          "bash": [
            {
              "type": "halve_damage_after_defense"
            }
          ],
          "heavy": [
            {
              "type": "halve_damage_after_defense"
            }
          ]
        }
      },
      "dodge": {
        "label": "闪避",
        "description": "消耗行动力，避开本拍攻击。",
        "cost": 2,
        "tag": "位移",
        "effects": [
          {
            "type": "avoid_damage",
            "against": [
              "bash",
              "heavy"
            ]
          }
        ]
      }
    },
    "heavy_damage": 10,
    "low_hp_ratio": 0.25,
    "player_heavy_bonus": 2,
    "player_heavy_mult": 2
  },
  "event_rules": [
    {
      "id": "claim_treasure_sets_flag",
      "label": "在洞穴捡起金币宝藏 → 标记试炼完成",
      "on": "ITEM_TAKEN",
      "if": {
        "item_id": "gold_coin",
        "from_scene": "cave"
      },
      "do": [
        {
          "type": "set_flag",
          "flag": "demo_complete"
        }
      ]
    },
    {
      "id": "slime_drops_key_unlocks_cave",
      "label": "击败史莱姆 → 拿到钥匙并解锁洞穴门",
      "on": "ENEMY_KILLED",
      "if": {
        "enemy_id": "slime"
      },
      "do": [
        {
          "type": "unlock",
          "scene": "forest",
          "exit": "cave"
        }
      ]
    }
  ]
}