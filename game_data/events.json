      ]
    },
    {
      "key": "ITEM_BOUGHT",
      "label": "购买物品时",
      "params": [
        {"field": "item_id", "label": "物品", "type": "ref", "ref": "item", "required": true},
        {"field": "from_scene", "label": "地点", "type": "ref", "ref": "scene", "required": false}
      ]
    },
    {
      "key": "ENEMY_KILLED",
      "label": "击败敌人时",
      "params": [
        {"field": "enemy_id", "label": "敌人", "type": "ref", "ref": "enemy", "required": true}
      ]
